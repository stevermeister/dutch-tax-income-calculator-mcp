{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dutch-tax-income-calculator-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Path-scoped routes, not a Custom Domain: thetax.nl's apex is already live
  // (served via Netlify through Cloudflare DNS). These only claim the exact
  // paths below — everything else keeps going to Netlify untouched. Each
  // extra top-level path (docs/privacy/terms/well-known challenge) needs its
  // own explicit route entry; a wildcard here would only match nested paths.
  "routes": [
    "thetax.nl/mcp*",
    "thetax.nl/docs",
    "thetax.nl/privacy",
    "thetax.nl/terms",
    "thetax.nl/.well-known/openai-apps-challenge"
  ],
  // 60 requests/minute per client IP. Cloudflare-managed counter — no Durable
  // Object of our own, keeps the handler stateless.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
