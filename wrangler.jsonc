{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dutch-tax-income-calculator-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Path-scoped route, not a Custom Domain: thetax.nl's apex is already live
  // (served via Netlify through Cloudflare DNS). This only claims /mcp* on
  // the domain — everything else keeps going to Netlify untouched.
  "routes": ["thetax.nl/mcp*"],
  // 60 requests/minute per client IP. Cloudflare-managed counter — no Durable
  // Object of our own, keeps the handler stateless.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
