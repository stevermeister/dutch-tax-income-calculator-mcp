{
  "name": "dutch-tax-income-calculator-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the dutch-tax-income-calculator npm package as tools and resources, deployed on Cloudflare Workers.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types src/worker-configuration.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
